{
    "name": "@thewaver/ss-components",
    "type": "module",
    "version": "0.0.1",
    "description": "SolidJS components for building shaped UI.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "license": "MIT",
    "author": "Luís Santos",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thewaver/ss-mono.git",
        "directory": "components"
    },
    "bugs": {
        "url": "https://github.com/thewaver/ss-mono/issues"
    },
    "homepage": "https://github.com/thewaver/ss-mono#readme",
    "scripts": {
        "build": "vite build && tsup src/index.ts --format esm --dts-only",
        "dev": "vite build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.3",
        "@tanstack/solid-virtual": "^3.13.37",
        "colorthief": "^3.5.0"
    },
    "peerDependencies": {
        "@thewaver/ss-utils": "^0.0.22",
        "solid-js": "^1.9.15"
    },
    "devDependencies": {
        "@thewaver/ss-utils": "^0.0.22",
        "@vanilla-extract/css": "^1.21.2",
        "@vanilla-extract/dynamic": "^2.1.5",
        "@vanilla-extract/vite-plugin": "^5.2.6",
        "solid-js": "^1.9.15",
        "tsup": "^8.5.1",
        "vite": "^8.2.1",
        "vite-plugin-solid": "^2.11.14"
    }
}
