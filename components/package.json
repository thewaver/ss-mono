{
    "name": "@thewaver/ss-components",
    "type": "module",
    "version": "0.0.2",
    "description": "SolidJS components for building shaped UI.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "license": "MIT",
    "author": "Luís Santos",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thewaver/ss-mono.git",
        "directory": "components"
    },
    "bugs": {
        "url": "https://github.com/thewaver/ss-mono/issues"
    },
    "homepage": "https://github.com/thewaver/ss-mono#readme",
    "keywords": [
        "solid",
        "solidjs",
        "solid-js",
        "components",
        "ui",
        "ui-components",
        "component-library",
        "design-system",
        "typescript",
        "form",
        "form-controls",
        "input",
        "text-field",
        "number-input",
        "currency-input",
        "masked-input",
        "tag-input",
        "file-input",
        "color-picker",
        "date-picker",
        "date-range-picker",
        "time-picker",
        "calendar",
        "select",
        "multiselect",
        "checkbox",
        "radio",
        "toggle",
        "switch",
        "slider",
        "range",
        "modal",
        "dialog",
        "drawer",
        "popover",
        "tooltip",
        "menu",
        "tabs",
        "accordion",
        "collapsible",
        "breadcrumbs",
        "pagination",
        "stepper",
        "tree",
        "toolbar",
        "toast",
        "notification",
        "carousel",
        "scroller",
        "split-pane",
        "sortable",
        "drag-and-drop",
        "table",
        "data-grid",
        "data-table",
        "grid",
        "resizable-columns",
        "sortable-columns",
        "column-reordering",
        "progress",
        "spotlight",
        "onboarding",
        "virtualization",
        "animation",
        "3d",
        "flip-card",
        "odometer",
        "typewriter",
        "scratch-card",
        "mosaic",
        "wheel",
        "rich-text",
        "shape",
        "squircle",
        "superellipse",
        "svg",
        "clip-path",
        "accessibility",
        "a11y",
        "aria",
        "wai-aria",
        "vanilla-extract",
        "css-in-js"
    ],
    "scripts": {
        "build": "vite build && tsup src/index.ts --format esm --dts-only",
        "dev": "vite build --watch",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@tanstack/solid-virtual": "^3.13.37",
        "colorthief": "^3.5.0"
    },
    "peerDependencies": {
        "@thewaver/ss-utils": "^0.0.23",
        "solid-js": "^1.9.15"
    },
    "devDependencies": {
        "@thewaver/ss-utils": "^0.0.23",
        "@vanilla-extract/css": "^1.21.2",
        "@vanilla-extract/dynamic": "^2.1.5",
        "@vanilla-extract/vite-plugin": "^5.2.6",
        "solid-js": "^1.9.15",
        "tsup": "^8.5.1",
        "vite": "^8.2.2",
        "vite-plugin-solid": "^2.11.14"
    }
}
