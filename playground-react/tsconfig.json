{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "allowImportingTsExtensions": true,
        "paths": {
            "@thewaver/ss-components/internal": ["../components/src/internal.ts"],
            "@thewaver/ss-components": ["../components/src/index.ts"],
            "@thewaver/ss-components-react": ["../components-react/src/index.ts"],
            "@thewaver/ss-utils": ["../utils/src/index.ts"],
            "@thewaver/ss-playground/*": ["../playground/src/*"]
        }
    },
    "include": ["src", "../playground/src/global.d.ts", "vite.config.ts"]
}
