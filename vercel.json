{
    "buildCommand": "npm run build:site",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/solid",
            "destination": "/solid/",
            "permanent": true
        },
        {
            "source": "/react",
            "destination": "/react/",
            "permanent": true
        },
        {
            "source": "/vue",
            "destination": "/vue/",
            "permanent": true
        },
        {
            "source": "/svelte",
            "destination": "/svelte/",
            "permanent": true
        },
        {
            "source": "/:path((?!solid(?:/|$)|react(?:/|$)|vue(?:/|$)|svelte(?:/|$)|index\\.html$).+)",
            "destination": "/solid/:path",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/solid/(.*)",
            "destination": "/solid/index.html"
        },
        {
            "source": "/react/(.*)",
            "destination": "/react/index.html"
        },
        {
            "source": "/vue/(.*)",
            "destination": "/vue/index.html"
        },
        {
            "source": "/svelte/(.*)",
            "destination": "/svelte/index.html"
        }
    ]
}
